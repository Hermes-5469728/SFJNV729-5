{
	"nodes":[
		{"id":"title","x":500,"y":20,"width":600,"height":60,"type":"text","text":"# 第二十四章 胃炎 · 考点图谱\n🔗 原文：内科学（人卫版）| 已入库 ac_truth rowid=104+105 L5","fontSize":20,"color":"#1a1a2e","backgroundColor":"#e8e8ff"},
		{"id":"group-kaodian","x":20,"y":120,"width":280,"height":780,"type":"group","label":"📌 考点"},
		{"id":"group-yuanwen","x":340,"y":120,"width":280,"height":780,"type":"group","label":"📖 原文定位"},
		{"id":"group-jiaocha","x":660,"y":120,"width":280,"height":780,"type":"group","label":"🔗 交叉学科"},
		{"id":"group-lianxi","x":980,"y":120,"width":280,"height":780,"type":"group","label":"🧪 考题连接"},
		{"id":"kd1","x":30,"y":150,"width":260,"height":80,"type":"text","text":"**考点1：急性胃炎最常见病因**\n急性糜烂出血性胃炎最常见原因 = NSAIDs","color":"#2d3436","backgroundColor":"#dfe6e9"},
		{"id":"yw1","x":350,"y":150,"width":260,"height":80,"type":"text","text":"**第二十四章 → 急性胃炎 → 病因**\n'化学药物中以非甾体抗炎药（NSAID）最多见'\n机制：抑制COX → PGE↓ → 黏膜修复障碍","color":"#2d3436","backgroundColor":"#ffeaa7"},
		{"id":"jc1","x":670,"y":150,"width":260,"height":80,"type":"text","text":"**药理学**\nNSAIDs → COX-1/COX-2 抑制\n→ PGE₂ 合成↓\n→ 胃黏膜血流↓ + 黏液分泌↓\n→ 黏膜屏障受损","color":"#2d3436","backgroundColor":"#81ecec"},
		{"id":"lx1","x":990,"y":150,"width":260,"height":80,"type":"text","text":"**选择题 #1**\n'急性糜烂出血性胃炎最常见原因'\n答案：B. 口服非甾体抗炎药\n陷阱：排除不洁饮食、刺激性食物","color":"#2d3436","backgroundColor":"#fab1a0"},
		{"id":"kd2","x":30,"y":260,"width":260,"height":80,"type":"text","text":"**考点2：急性胃炎病因→不包括Hp**\n急性胃炎5大病因：理化/应激/反流/感染/循环\nHp → 慢性胃炎（非急性胃炎常见病因）","color":"#2d3436","backgroundColor":"#dfe6e9"},
		{"id":"yw2","x":350,"y":260,"width":260,"height":80,"type":"text","text":"**第二十四章 → 慢性胃炎 → 病因**\n'幽门螺杆菌感染是慢性胃炎最主要的病因'\n定位与急性胃炎病因段对比阅读","color":"#2d3436","backgroundColor":"#ffeaa7"},
		{"id":"jc2","x":670,"y":260,"width":260,"height":80,"type":"text","text":"**微生物学**\nHp：G⁻微需氧菌\n→ 尿素酶产氨 → 中和胃酸\n→ 定植于胃窦黏膜层\n→ 慢性感染为主，初次感染可急性发作","color":"#2d3436","backgroundColor":"#81ecec"},
		{"id":"lx2","x":990,"y":260,"width":260,"height":80,"type":"text","text":"**选择题 #2 + #3**\n#2：急性胃炎不包括 Hp\n#3：Hp是慢性胃炎+消化性溃疡病原\n两题对比考：急性 vs 慢性病因归属","color":"#2d3436","backgroundColor":"#fab1a0"},
		{"id":"kd3","x":30,"y":370,"width":260,"height":110,"type":"text","text":"**考点3：Hp现症感染检查方法**\n能查：\n- ¹³C/¹⁴C尿素呼气试验\n- 快速尿素酶试验(RUT)\n- Hp培养\n- 粪便抗原检测\n不能查：血清抗体(IgG)","color":"#2d3436","backgroundColor":"#dfe6e9"},
		{"id":"yw3","x":350,"y":370,"width":260,"height":110,"type":"text","text":"**第二十四章 → 辅助检查 → Hp检测**\n侵入性：RUT / 组织学 / 培养\n非侵入性：¹³C-UBT / 粪便抗原 / 血清学\n\n血清IgG阳性 = 曾感染（不能区分现症vs既往）","color":"#2d3436","backgroundColor":"#ffeaa7"},
		{"id":"jc3","x":670,"y":370,"width":260,"height":110,"type":"text","text":"**免疫学**\nIgG抗体：感染后2~3周出现\n→ 根除后仍持续数月~数年\n→ 不能反映当前感染状态\n\n**对比**：UBT检测尿素酶活性→只有活菌才有","color":"#2d3436","backgroundColor":"#81ecec"},
		{"id":"lx3","x":990,"y":370,"width":260,"height":110,"type":"text","text":"**单选题**\n'证实Hp现症感染不包括'\nA. 血清抗体检测 ✅排除\n\n**陷阱**：D选项\"尿激酶\" vs \"尿素酶\"\nRUT=尿素酶试验，非尿激酶","color":"#2d3436","backgroundColor":"#fab1a0"},
		{"id":"kd4","x":30,"y":510,"width":260,"height":80,"type":"text","text":"**考点4：慢性胃炎活动性标志**\n病理活动性 = 中性粒细胞浸润\n（非活动期 = 淋巴细胞/浆细胞）","color":"#2d3436","backgroundColor":"#dfe6e9"},
		{"id":"yw4","x":350,"y":510,"width":260,"height":80,"type":"text","text":"**第二十四章 → 慢性胃炎 → 病理-炎症**\n'炎症活动可见中性粒细胞浸润'\n慢性炎症细胞 = 淋巴/浆细胞","color":"#2d3436","backgroundColor":"#ffeaa7"},
		{"id":"jc4","x":670,"y":510,"width":260,"height":80,"type":"text","text":"**病理学**\n中性粒细胞 = 急性炎症标志\n淋巴细胞/浆细胞 = 慢性炎症标志\n两者同时存在 → 慢性炎急性发作","color":"#2d3436","backgroundColor":"#81ecec"},
		{"id":"lx4","x":990,"y":510,"width":260,"height":80,"type":"text","text":"**选择题 #7**\n'判断慢性胃炎活动性的病理依据'\n答案：C. 中性粒细胞浸润\n排除：浆细胞/淋巴细胞（慢性）","color":"#2d3436","backgroundColor":"#fab1a0"},
		{"id":"kd5","x":30,"y":620,"width":260,"height":110,"type":"text","text":"**考点5：自身免疫性胃炎**\n确诊标志：血清壁细胞抗体(PCA)\n机制：PCA攻击壁细胞→内因子↓→B₁₂吸收障碍→大细胞性贫血\n治疗：终身注射B₁₂","color":"#2d3436","backgroundColor":"#dfe6e9"},
		{"id":"yw5","x":350,"y":620,"width":260,"height":110,"type":"text","text":"**第二十四章 → 自身免疫 → 诊断**\n'检测血清壁细胞抗体(PCA)和内因子抗体(IFA)及维生素B₁₂水平'\n\n链：PCA→壁细胞↓→胃酸↓+内因子↓→B₁₂吸收↓→恶性贫血","color":"#2d3436","backgroundColor":"#ffeaa7"},
		{"id":"jc5","x":670,"y":620,"width":260,"height":110,"type":"text","text":"**血液病学**\n巨幼细胞性贫血（大细胞性）\nMCV↑ → 骨髓巨幼变\nB₁₂缺乏 → DNA合成障碍\n\n**病理学**：A型胃炎→胃体萎缩→壁细胞消失","color":"#2d3436","backgroundColor":"#81ecec"},
		{"id":"lx5","x":990,"y":620,"width":260,"height":110,"type":"text","text":"**选择题 #8 + #11**\n#8：自身免疫性胃炎确诊→PCA\n#11：大细胞性贫血→补B₁₂\n\n**陷阱区分**：缺铁性贫血(小细胞) vs B₁₂缺乏(大细胞)","color":"#2d3436","backgroundColor":"#fab1a0"},
		{"id":"kd6","x":30,"y":760,"width":260,"height":80,"type":"text","text":"**考点6：Hp根除方案**\n铋剂四联：\nPPI + 铋剂 + 2种抗生素\n疗程：10~14天","color":"#2d3436","backgroundColor":"#dfe6e9"},
		{"id":"yw6","x":350,"y":760,"width":260,"height":80,"type":"text","text":"**第二十四章 → 对因治疗 → Hp根除**\n'推荐铋剂四联方案：1种PPI+1种铋剂+2种抗生素，疗程10~14d'\nPPI：奥美拉唑等；铋剂：枸橼酸铋钾\n抗生素：克拉霉素+阿莫西林","color":"#2d3436","backgroundColor":"#ffeaa7"},
		{"id":"jc6","x":670,"y":760,"width":260,"height":80,"type":"text","text":"**药理学**\nPPI：不可逆抑制H⁺/K⁺-ATP酶\n克拉霉素：大环内酯类\n阿莫西林：β-内酰胺类\n铋剂：局部抗菌+黏膜保护\n\n**耐药对策**：克拉霉素耐药率>15%→换左氧氟沙星","color":"#2d3436","backgroundColor":"#81ecec"},
		{"id":"lx6","x":990,"y":760,"width":260,"height":80,"type":"text","text":"**选择题 #9**\n'根除Hp首选方案'\n答案：C. PPI+克拉霉素+铋剂+阿莫西林10d\n\n**排除干扰**：三联不够(缺铋)，H₂RA非PPI，疗程不足","color":"#2d3436","backgroundColor":"#fab1a0"}
	],
