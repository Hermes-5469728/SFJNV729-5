  "presence": {
    "daily_greeting": false,
    "periodic_checkin": false,
    "event_driven_only": true,
    "active_push_enabled": true,
    "trigger_events": [
      "emotional_crisis_keyword",
      "inactivity_3days",
      "late_night_active",
      "silence_after_emotional_crisis"
