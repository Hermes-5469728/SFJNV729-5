      "fallback_strategy": "empathy",
      "cooldown_seconds": 300
    },
    {
      "rule_id": "trigger_laibuji",
      "name": "来不及了",
      "enabled": true,
      "priority": "P3",
      "triggers": [
        { "match_type": "contains", "pattern": "来不及了", "case_sensitive": false }
